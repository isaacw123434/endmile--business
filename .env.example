# EndMile Outbound Outreach SMTP Configuration
# -----------------------------------------------
# Copy this file to .env and fill in your mailbox details.
# This file is strictly git-ignored and never committed.

# 20i Stackmail configuration (default for endmilerouting.co.uk):
SMTP_HOST=smtp.stackmail.com
SMTP_PORT=587
SMTP_USER=isaacw@endmilerouting.co.uk
SMTP_PASSWORD=your_20i_mailbox_password_here

# Alternatively, if using Google Workspace / Gmail (requires App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@domain.com
# SMTP_PASSWORD=your_16_digit_app_password
